# Induced modules of quotients of universal vertex algebras, up to a depth
# (quotient_induced_module.py): \bar M_V(U) modulo what the relations of the
# quotient (and, for presentations, the commutator formula) generate.
# Checked: the triplet algebra W(2) at c = -2 from its presentation inside
# symplectic fermions: from the trivial top the module W(0) -> 2 W(1), from
# the 2-dimensional Jordan block of L_0 the projective cover P(0) = W(0) ->
# 2 W(1) -> W(0) (Gaberdiel-Kausch; characters χ_0 + 2 χ_1 and 2 χ_0 + 2 χ_1
# by depth and fermion charge, χ from the symplectic fermion Fock space;
# also the even part of the logarithmic module of symplectic fermions
# induced from the Grassmann top), the socle W(0) generated by L_0 of the
# top, the simple quotient = W(2) itself, stability in weight and depth, no
# commutator defects; consistent quotients (Lee-Yang, the Ising model as a
# presentation, L_1(sl_2) inside V_{A_1}) against known characters; a top
# killed by the relations; refusals; TestSuite, pickling.
# Run from the repository root:  sage tests/smoke_quotient_induced_modules.sage  -> RESULT: PASS
import os
import sys
import time

sys.path.insert(0, os.path.join(os.getcwd(), 'tests'))
from vertex_algebras.universal_vertex_algebra import UniversalVertexAlgebra
from vertex_algebras.normally_ordered_expressions import NormallyOrderedExpressions
from vertex_algebras.lattice_vertex_algebra import LatticeVertexAlgebra
from axioms import Reporter

report = Reporter()
t_start = time.time()

# 1. the triplet algebra W(2) at c = -2 ----------------------------------------------------------
Y.<cp, cm> = NormallyOrderedExpressions(QQ, parities={'cp': 1, 'cm': 1})
SF = UniversalVertexAlgebra(QQ, Y, {('cp', 'cm'): [0, 1]}, conformal_vector=cm * cp,
                            horizontal_grading={'cp': 1, 'cm': -1})
a, b = SF.gens()
Wp, Wm = a.no(a.derivative()), b.no(b.derivative())
W0 = a.no(b.derivative()) + b.no(a.derivative())
S2 = SF.subalgebra([SF.conformal_vector(), Wp, W0, Wm], names=['T', 'Wp', 'W0', 'Wm'],
                   horizontal_grading='ambient', conformal_vector='ambient')
P2 = S2.presentation()
Z2 = P2.zhu_algebra_up_to(8)
Z0 = matrix(QQ, 2, 2)
Ut = Z2.module({'T': 0, 'Wp': 0, 'W0': 0, 'Wm': 0}, horizontal_grades=[0])
Uj = Z2.module({'T': matrix([[0, 1], [0, 0]]), 'Wp': Z0, 'W0': Z0, 'Wm': Z0}, horizontal_grades=[0, 0])

# χ_0, χ_1 by depth and charge: the even / odd part of the Fock space of the
# symplectic fermions χ^±_{-n}, n >= 1 (charge ±1 each)
R.<y> = LaurentPolynomialRing(QQ)
S.<q> = PowerSeriesRing(R, default_prec=10)
fock = prod((1 + y * q ^ n) * (1 + y ^ -1 * q ^ n) for n in range(1, 10))


def chi(par, d, g):
    """The dimension of the part of parity par of the Fock space at depth d, charge g."""
    c = fock[d]
    return c[g] if (g - par) % 2 == 0 else 0


horizontal_grades = [-4, -2, 0, 2, 4]


def chi01(k, d, g):
    """k χ_0 + 2 χ_1 at depth d, W(2)-charge g: the two W(1) of these modules have
    the charges of the W(1) of symplectic fermions shifted by ±1 (their tops
    are W^±_{-1} u, T_{-1} u, W^0_{-1} u, of charges ±2, 0)."""
    return k * chi(0, d, g) + chi(1, d, g - 1) + chi(1, d, g + 1)

t = time.time()
M0 = P2.induced_module_up_to(Ut, 8, 6)
ok = all(M0.weight_space(d, horizontal_grade=g).dimension() == chi01(1, d, g) for d in range(7) for g in horizontal_grades)
ok = ok and [M0.weight_space(d).dimension() for d in range(7)] == [1, 4, 5, 8, 13, 20, 34]
report('W(2), trivial top: W(0) -> 2 W(1), χ_0 + 2 χ_1 by depth and charge to depth 6', ok,
       '%.1fs' % (time.time() - t))
t = time.time()
L0 = M0.simple_quotient()
report('W(2), trivial top: the simple quotient is W(2) itself; no commutator defects',
       [L0.weight_space(d).dimension() for d in range(7)] == [S2.weight_space(d).dimension() for d in range(7)]
       and M0.defining_submodule()._ndefects == 0, '%.1fs' % (time.time() - t))
t = time.time()
ok = all(P2.induced_module_up_to(Ut, W, D).weight_space(d, horizontal_grade=g).dimension()
         == M0.weight_space(d, horizontal_grade=g).dimension()
         for W, D in ((6, 5), (10, 5), (8, 4)) for d in range(D + 1) for g in horizontal_grades)
report('W(2), trivial top: stable in weight (6, 8, 10) and depth (4, 5, 6)', ok, '%.1fs' % (time.time() - t))

t = time.time()
Mj = P2.induced_module_up_to(Uj, 8, 5)
ok = all(Mj.weight_space(d, horizontal_grade=g).dimension() == chi01(2, d, g) for d in range(6) for g in horizontal_grades)
T = P2.gen('T')
u0, u1 = [Mj(Mj.ambient().monomial(((), i))) for i in range(2)]
ok = ok and T.mode(u1, 0) == u0 and T.mode(u0, 0).is_zero() and Mj.top_weight() == 0
report('W(2), Jordan top: P(0) = W(0) -> 2 W(1) -> W(0), 2 χ_0 + 2 χ_1, L_0 not diagonalizable', ok,
       '%.1fs' % (time.time() - t))
t = time.time()
soc = Mj.submodule([u0])
report('W(2), Jordan top: L_0 of the top generates the socle W(0)',
       all(soc.weight_space(d, horizontal_grade=g).dimension() == chi(0, d, g) for d in range(6) for g in horizontal_grades),
       '%.1fs' % (time.time() - t))

# the even part of the logarithmic module of symplectic fermions induced
# from the Grassmann algebra on the zero modes (top C^{2|2})
t = time.time()
ZSF = SF.zhu_algebra()
Ep = matrix(QQ, 4, 4, {(1, 0): 1, (3, 2): 1})          # basis 1, θ+, θ-, θ+θ- (rows: images)
Em = matrix(QQ, 4, 4, {(2, 0): 1, (3, 1): -1})
Ugr = ZSF.module({'cp': Ep, 'cm': Em}, parities=[0, 1, 1, 0], horizontal_grades=[0, 1, -1, 0])
Msf = SF.induced_module(Ugr)
even = [[sum(1 for k in Msf.weight_space(d, horizontal_grade=g).basis_keys() if Msf._parity_key(k) == 0)
         for g in horizontal_grades] for d in range(6)]
report('W(2), Jordan top: dimensions = the even part of the logarithmic symplectic fermion module',
       even == [[Mj.weight_space(d, horizontal_grade=g).dimension() for g in horizontal_grades] for d in range(6)],
       '%.1fs' % (time.time() - t))

# 2. consistent quotients --------------------------------------------------------------------------
E.<L> = NormallyOrderedExpressions(QQ)
Vly = UniversalVertexAlgebra(QQ, E, {('L', 'L'): [L.derivative(), 2 * L, 0, -11 / 5]}, conformal_vector=L)
Lv = Vly.gen('L')
Qly = Vly / [Lv.no(Lv) - 3 / 10 * Lv.derivative(2)]
Zly = Qly.zhu_algebra_up_to(4)
ok = all([Qly.induced_module_up_to(Zly.module({'L': h}), 4, 10).weight_space(h + d).dimension()
          for d in range(11)] == [Vly.verma_module(h).simple_quotient().weight_space(h + d).dimension()
                                  for d in range(11)] for h in (0, -1 / 5))
X.<psi> = NormallyOrderedExpressions(QQ, parities={'psi': 1})
Maj = UniversalVertexAlgebra(QQ, X, {('psi', 'psi'): [1]}, conformal_vector=psi.derivative() * psi / 2)
P1 = Maj.subalgebra([Maj.conformal_vector()], names=['L'], conformal_vector='ambient').presentation()
Z1 = P1.zhu_algebra_up_to(6)
Vis = UniversalVertexAlgebra(QQ, E, {('L', 'L'): [L.derivative(), 2 * L, 0, 1 / 4]}, conformal_vector=L)
ok = ok and all([P1.induced_module_up_to(Z1.module({'L': h}), 6, 9).weight_space(h + d).dimension()
                 for d in range(10)] == [Vis.verma_module(h).simple_quotient().weight_space(h + d).dimension()
                                         for d in range(10)] for h in (0, 1 / 2, 1 / 16))
LA = LatticeVertexAlgebra(QQ, matrix([[2]]))
J = LA.J(0)
VA = LA.with_conformal_vector(J.no(J) / 4)
P3 = VA.subalgebra([VA.e((1,)), VA.e((-1,))], names=['E', 'F']).presentation()
Z3 = P3.zhu_algebra_up_to(3)
names3 = P3.ambient().variable_names()
H3 = [n for n in names3 if n not in ('E', 'F')][0]
hval = P3.ambient().gen('E').ope(P3.ambient().gen('F'))[0]   # E_(0) F = ± the third generator
sgn = hval.monomial_coefficients()[next(iter(hval.support()))]
Ud = Z3.module({'E': matrix([[0, 1], [0, 0]]), 'F': matrix([[0, 0], [1, 0]]),
                H3: sgn * matrix([[1, 0], [0, -1]])})
Md = P3.induced_module_up_to(Ud, 3, 6)
Ml = VA.simple_module([1 / 2])
ok = ok and [Md.weight_space(d).dimension() for d in range(7)] \
    == [Ml.weight_space(1 / 4 + d).dimension() for d in range(7)]
report('consistent quotients: Lee-Yang L(0), L(-1/5); Ising L(0), L(1/2), L(1/16); L_1(sl2) doublet = V_{1/2+A1}', ok)

# 3. a top killed by the relations, refusals, TestSuite ------------------------------------------------
refused = []
try:
    Qly.induced_module_up_to(Vly.zhu_algebra().module({'L': 1 / 3}), 4, 3)
    refused.append('top not a module over A(Q)')
except ValueError:
    pass
try:
    Qly.induced_module_up_to(Vly.zhu_algebra().module({'L': 1 / 3}), 4, 3)
    refused.append('top not a module over A(Q) (cached)')
except ValueError:
    pass
try:
    M0.weight_space(7)
    refused.append('beyond the depth')
except ValueError:
    pass
try:
    Vly.induced_module_up_to(Zly.module({'L': 0}), 4, 3)
    refused.append('not a quotient')
except AttributeError:
    pass
report('refused: a top killed by the relations, beyond the depth, a universal algebra', not refused, refused)

t = time.time()
TestSuite(M0).run()
TestSuite(Mj).run()
report('TestSuite, pickling', loads(dumps(M0)) is M0 and loads(dumps(Mj)) is Mj, '%.1fs' % (time.time() - t))

print('total %.1fs' % (time.time() - t_start))
report.result()
